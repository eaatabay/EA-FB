{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "ea-fb-catalog-v6-staging",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "PER_CLIENT_LIMIT",
      "namespace_id": "1101",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "GLOBAL_LIMIT",
      "namespace_id": "1102",
      "simple": { "limit": 500, "period": 60 }
    }
  ]
}
