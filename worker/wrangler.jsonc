{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "ea-fb-catalog",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "PER_CLIENT_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 500,
        "period": 60
      }
    }
  ]
}
