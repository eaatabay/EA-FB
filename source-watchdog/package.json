{
  "name": "ea-fb-source-watchdog",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev --test-scheduled",
    "seed:fixtures": "node dev/generate-fixture-seed.mjs",
    "test:migration": "python3 -m unittest discover -s tests -v",
    "dev:fixture": "wrangler dev --local --test-scheduled --config wrangler.local.jsonc",
    "test:local": "bash dev/run-local-fixtures.sh",
    "test:wrangler-local": "node dev/verify-local-wrangler.mjs",
    "test:release-local": "bash dev/run-release-validation.sh"
  },
  "devDependencies": {
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
